<!--
  Central package management (ADR-0002): every NuGet version lives here, once.
  Projects reference packages without a Version attribute.
  Aspire packages stay on the same version as the AppHost SDK (PI.AppHost.csproj).
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion here pin a transitive dependency (e.g. AngleSharp, below)
         without adding a direct PackageReference to it in any project. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Orchestration (ADR-0002) -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />
  </ItemGroup>

  <!-- API and Aspire service defaults -->
  <ItemGroup>
    <PackageVersion Include="FastEndpoints" Version="8.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.3" />
  </ItemGroup>

  <!-- Data: Postgres + pgvector (ADR-0006) -->
  <ItemGroup>
    <!-- Aspire.Npgsql 13.4.6 requires Npgsql >= 10.0.2; pin explicitly so it isn't downgraded to 10.0.0. -->
    <PackageVersion Include="Npgsql" Version="10.0.2" />
    <PackageVersion Include="Aspire.Npgsql" Version="13.4.6" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
  </ItemGroup>

  <!-- Ontology: Turtle/SKOS parsing and SPARQL (ADR-0013) -->
  <ItemGroup>
    <PackageVersion Include="dotNetRdf.Core" Version="3.5.2" />
    <!-- dotNetRdf.Core depends on AngleSharp for its (unused here) HTML parsing support.
         Pinned above its transitive floor to clear GHSA-pgww-w46g-26qg. -->
    <PackageVersion Include="AngleSharp" Version="1.8.1" />
  </ItemGroup>

  <!-- Local embeddings (ADR-0009). IEmbeddingGenerator comes from the same abstractions family as IChatClient (ADR-0015). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <!-- Tests (ADR-0002) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
