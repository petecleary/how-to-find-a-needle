# Every taxonomy concept, with its notation, labels, icon, device-type flag and
# English definition. DomainOntology.cs groups these rows into a tree in C#, using
# the separate broader relationship each row carries (skos:broader* recursion is
# not done here — see narrower.rq for the transitive version).
# Synonyms (skos:altLabel) come from labels.rq, so this query stays one row per
# (concept, preferred label) pair.
PREFIX ex:   <https://needle.example/ontology#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?concept ?notation ?broaderNotation ?icon ?isDeviceType ?definition ?label ?lang
WHERE {
    ?concept a skos:Concept ;
             skos:inScheme <https://needle.example/ontology#Taxonomy> ;
             skos:notation ?notation ;
             skos:prefLabel ?label .
    BIND(LANG(?label) AS ?lang)
    OPTIONAL { ?concept skos:broader ?broader . ?broader skos:notation ?broaderNotation . }
    OPTIONAL { ?concept ex:icon ?icon . }
    OPTIONAL { ?concept ex:isDeviceType ?isDeviceType . }
    OPTIONAL { ?concept skos:definition ?definition . FILTER(LANGMATCHES(LANG(?definition), "en")) }
}
ORDER BY ?notation ?lang
